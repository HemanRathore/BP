# Copy values into private deployment environment variables. Never commit real values.
DATABASE_URL=postgresql://APP_ROLE:ROTATED_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL_CA=PASTE_SUPABASE_DATABASE_CA_PEM_HERE
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_SECRET
IP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
